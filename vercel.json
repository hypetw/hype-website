{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/blog/property-ai-listing-time",
      "destination": "/blog/listing-studio-sell-property-faster",
      "permanent": true
    },
    {
      "source": "/blog/property-ai-listing-time.html",
      "destination": "/blog/listing-studio-sell-property-faster",
      "permanent": true
    },
    {
      "source": "/property.html",
      "destination": "/property",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/videos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/logos/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)\\.(css|js|woff|woff2|ttf|otf|eot|svg|ico|png|jpg|jpeg|webp|avif|gif|mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
